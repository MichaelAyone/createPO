# 统一换行符策略：仓库里一律存 LF
* text=auto

# Linux 上执行的脚本必须是 LF，否则报 /bin/bash^M: bad interpreter
*.sh    text eol=lf
*.bash  text eol=lf
# Windows 批处理必须是 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制文件不做任何转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.jar   binary
*.zip   binary
*.pdf   binary
